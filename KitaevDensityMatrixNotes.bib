@FOOTNOTE{Note1,key="Note1",note="The gauge field operators $\protect \hat  {u}_{ij}$ commute with the Hamiltonian and so the ground state is also an eigenvector of operators $\protect \hat  {u}_{ij}$, thus the gauge operator in the Hamiltonian \protect \eqref  {equ.MF-Hamiltonian} can be fixed to their eigenvalues $\pm 1$, and Hamiltonian \protect \eqref  {equ.MF-Hamiltonian} then becomes quadratic in $c$."}
@FOOTNOTE{Note2,key="Note2",note="The gauge field in the Kitaev model is said to be static because the expectation value of gauge fluxes are non-fluctuating, and there's no term related to the dynamics of the gauge field in the Lagrangian."}
@FOOTNOTE{Note3,key="Note3",note="In this Gauss law formula, we can see the $c$-Majorana fermion operator is exactly the matter field $c_i=\protect \mathrm  {e}^{i\pi \rho _i}$ if the $b$-Majorana operators are represented as $b^{\alpha _{ij}}_i=\protect \mathrm  {e}^{i\pi E_{ij}}$. After that, the exponent becomes the familiar form $\div {E}=\rho $"}
@FOOTNOTE{Note4,key="Note4",note="Two distinct Majorana fermions, say $c_1$ and $c_2$, can combine to form a normal fermion degree of freedom $f$ in a way that $f=\protect \frac  {1}{2}\left ( c_1+ic_2 \right )$ and $f^\dagger =\protect \frac  {1}{2}\left ( c_1-ic_2 \right )$. In this way, the fermion parity operator represented using the Majorana fermions becomes $\protect \hat  {\protect \bm  {\pi }}\equiv (-1)^{f^\dagger f}=ic_1c_2$. In a more general sense, the fermion parity operator is equal to the multiplication of all the Majorana fermions $\DOTSB \prod@ \slimits@ _i c_i$ up to a phase."}
@FOOTNOTE{Note5,key="Note5",note="Note that the projector $\protect \mathcal  {P}^{(p)}$ becomes \protect \[\protect \mathcal  {P}^{(p)} \to \DOTSB \prod@ \slimits@ _{ p}\left ( \protect \frac  {\protect \mathds  {1} + \DOTSB \prod@ \slimits@ _{\left \langle ij \right \rangle \in p}\protect \hat  {u}_{ij}}{2} \right )\protect \] in the Majorana representation, where ``$\left \langle ij \right \rangle \in p$'' stands for \protect \textit  {those edges of the plaquette $p$}."}
@FOOTNOTE{Note6,key="Note6",note="Don't forget that a loop also counts a string, just with two endpoints at the same position. Therefore, proving that every string operator commutes with $\xi _n$ also proves that every plaquette operator commutes with $\xi _n$ at the same time."}
