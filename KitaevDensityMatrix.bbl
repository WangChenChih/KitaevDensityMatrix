\bibitem [{Note3()}]{Note3}%
  \BibitemOpen
  \bibinfo {note} {In this Gauss law formula, we can see the $c$-Majorana
  fermion operator is exactly the matter field $c_i=\protect \mathrm {e}^{i\pi
