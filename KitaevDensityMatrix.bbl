\bibitem [{Note4()}]{Note4}%
  \BibitemOpen
  \bibinfo {note} {Two distinct Majorana fermions, say $c_1$ and $c_2$, can
  combine to form a normal fermion degree of freedom $f$ in a way that
  $f=\protect \frac {1}{2}\left ( c_1+ic_2 \right )$ and $f^\dagger =\protect
  \frac {1}{2}\left ( c_1-ic_2 \right )$. In this way, the fermion parity
  operator represented using the Majorana fermions becomes $\protect \hat
  {\protect \bm {\pi }}\equiv (-1)^{f^\dagger f}=ic_1c_2$. In a more general
  sense, the fermion parity operator is equal to the multiplication of all the
  Majorana fermions $\DOTSB \prod@ \slimits@ _i c_i$ up to a
  phase.}\BibitemShut {Stop}%
\bibitem [{Note5()}]{Note5}%
  \BibitemOpen
  \bibinfo {note} {Note that the projector $\protect \mathcal {P}^{(p)}$
  becomes \protect \[\protect \mathcal {P}^{(p)} \to \DOTSB \prod@ \slimits@ _{
  p}\left ( \protect \frac {\protect \mathds {1} + \DOTSB \prod@ \slimits@
  _{\left \langle ij \right \rangle \in p}\protect \hat {u}_{ij}}{2} \right
  )\protect \] in the Majorana representation, where ``$\left \langle ij \right
  \rangle \in p$'' stands for \protect \textit {those edges of the plaquette
  $p$}.}\BibitemShut {Stop}%
\bibitem [{Note6()}]{Note6}%
  \BibitemOpen
  \bibinfo {note} {Don't forget that a loop also counts a string, just with two
  endpoints at the same position. Therefore, proving that every string operator
  commutes with $\xi _n$ also proves that every plaquette operator commutes
  with $\xi _n$ at the same time.}\BibitemShut {Stop}%
