  \bibfield  {author} {\bibinfo {author} {\bibfnamefont {G.}~\bibnamefont
  {Baskaran}}, \bibinfo {author} {\bibfnamefont {S.}~\bibnamefont {Mandal}},\
  and\ \bibinfo {author} {\bibfnamefont {R.}~\bibnamefont {Shankar}},\
