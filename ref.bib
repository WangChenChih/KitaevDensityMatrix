@article{correlation-densitymatrix-2,
  author  = {Chen, Qi and Zhang, Guo-Qing and Cheng, Jun-Qing and Xu, Jing-Bo},
  title   = {Topological quantum phase transitions in the 2-D Kitaev honeycomb model},
  journal = {Quantum Information Processing},
  volume  = {18},
  number  = {1},
  pages   = {8},
  year    = {2019},
  doi     = {10.1007/s11128-018-2115-3},
  url     = {https://doi.org/10.1007/s11128-018-2115-3},
  issn    = {1573-1332},
  abstract = {We study the topological quantum phase transition in the 2-D Kitaev honeycomb model by making use of the square root of the quantum Jensen--Shannon divergence and find that the square root of the quantum Jensen--Shannon divergence exhibits singular behaviors at the critical point of quantum phase transition. The scaling behaviors of the square root of the quantum Jensen--Shannon divergence are also examined from the first-order derivatives, and we demonstrate that the square root of the quantum Jensen--Shannon divergence obeys universal finite-size scaling laws. Furthermore, we explore the performance of quantum discord and the relative entropy coherence of the system. It is shown that quantum discord and relative entropy coherence display similar critical behaviors, and the square root of the quantum Jensen--Shannon divergence and quantum discord can serve as good indicators for quantum phase transitions.}
}

