\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The electric-field operators living on the edges crossing the boundary of the region are split in half, as shown in the first panel. In the physical spin representation, these electric fields correspond to the spin operators $\sigma ^\mu $ with directions pointing outwards. The second panel displays string operators that connect two adjacent spins in the first panel in a pair. Multiplying the first panel by the second one gives a series of operators $\xi $, as shown in the third panel. Applying the same method but with the pairing order shifted yields another set of operators $\zeta $, as showcased in the last panel.}}{14}{figure.6}\protected@file@percent }
\newlabel{fig.xi-def}{{6}{14}{The electric-field operators living on the edges crossing the boundary of the region are split in half, as shown in the first panel. In the physical spin representation, these electric fields correspond to the spin operators $\sigma ^\mu $ with directions pointing outwards. The second panel displays string operators that connect two adjacent spins in the first panel in a pair. Multiplying the first panel by the second one gives a series of operators $\xi $, as shown in the third panel. Applying the same method but with the pairing order shifted yields another set of operators $\zeta $, as showcased in the last panel}{figure.6}{}}
\newlabel{equ.related-blocks}{{60}{14}{}{equation.60}{}}
\newlabel{equ.block-rho-final}{{61}{14}{}{equation.61}{}}
